# TOML; relative paths are resolved against this file's directory.
schema_version = 1
profile = "default"

[output]
# Omit format for TTY human / non-TTY jsonl. Agents should explicitly pass --format json.
color = false

[network]
request_timeout_seconds = 30
timeout_seconds = 300
retries = 2
request_interval_ms = 1000
# proxy = "http://127.0.0.1:7890"

[query]
limit = 20
page_size = 20
max_pages = 100
sort = "relevance"
type = "all"

[download]
paths = "./downloads"
template = "{author.id}/{note.id}/{index:03}_{media.role}.{ext}"
timezone = "Asia/Shanghai"
quality = "best"
video_codec = "auto"
progress = "auto" # auto: terminal only; always: force; never: disable
allow_quality_fallback = false
media = "all"
concurrency = 3
rate_limit = 0
resume = true
on_exists = "error"
write_info_json = true
write_description = true
dry_run = false
# archive = "./archive.jsonl"
