{
  "name": "xhs-dl",
  "version": "0.2.0",
  "description": "HTTP-only, agent-first Xiaohongshu CLI",
  "type": "module",
  "private": true,
  "bin": {
    "xhs-dl": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "references-lock.json"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src tests scripts eslint.config.js package.json tsconfig*.json vitest.config.ts",
    "format:check": "prettier --check src tests scripts eslint.config.js package.json tsconfig*.json vitest.config.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "lint": "eslint src tests",
    "docs:generate": "node scripts/command-reference.mjs",
    "docs:check": "node scripts/command-reference.mjs --check"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.8.0",
    "acorn": "^8.19.0",
    "commander": "^15.1.0",
    "proper-lockfile": "^4.1.2",
    "qrcode": "^1.5.4",
    "smol-toml": "^1.9.1",
    "tough-cookie": "^6.1.0",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/proper-lockfile": "^4.1.4",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
